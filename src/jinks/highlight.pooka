//// A small build-time colourist, not a second compiler. Token spelling is
//// always escaped before entering a span; an unknown language stays plain.
//// Lists of fragments keep a long code block from repeatedly copying itself.
module highlight

import marksy/html
import pooka/list
import pooka/string

span(kind: String, text: String) -> String {
  "<span class=\"tok-" + kind + "\">" + html.escape(text) + "</span>"
}

render(source: String, language: String) -> String {
  match language == "tree" || (
    (language == "text" || language == "") && is_tree(source)
  ) {
    True -> string.split(source, "\n") |> list.map(tree_line) |> string.join(
      "\n"
    )
    False -> code(source, language)
  }
}

code(source: String, language: String) -> String {
  match list.contains(
    [
      "pooka",
      "gleam",
      "erlang",
      "erl",
      "lfe",
      "lisp",
      "elixir",
      "ex",
      "toml",
      "sh",
      "shell",
      "bash",
      "javascript",
      "js",
      "json",
      "css",
      "html",
      "sql"
    ],
    language
  ) {
    True -> scan(string.split(source, ""), language, []) |> list.reverse() |> string.join(
      ""
    )
    False -> {
      let rows = string.split(source, "\n")
      let plain = language == "text" || language == ""
      let diagnostic = list.any(rows, fn(line) {
        diagnostic_kind(string.trim_start(line)) != ""
      })
      match True {
        _ if diagnostic && (plain || language == "terminal") ->
        diagnostic_lines(rows, "fail", []) |> string.join("\n")
        _ if language == "snapshot" || language == "terminal" || (
          plain && list.any(rows, terminal_line)
        ) -> list.map(rows, terminal) |> string.join("\n")
        _ -> html.escape(source)
      }
    }
  }
}

scan(chars: List(String), language: String, done: List(String)) -> List(String) {
  match chars {
    [] -> done
    ["/", "/", ..rest] if language != "toml" && language != "sh" && language != "shell" && language != "bash" -> {
      let #(body, rest) = until_line(rest, [])
      scan(rest, language, [span("comment", "//" + body), ..done])
    }
    ["#", ..rest] if list.contains(
      ["toml", "sh", "shell", "bash", "elixir", "ex"],
      language
    ) -> {
      let #(body, rest) = until_line(rest, [])
      scan(rest, language, [span("comment", "#" + body), ..done])
    }
    [";", ..rest] if language == "lfe" || language == "lisp" -> {
      let #(body, rest) = until_line(rest, [])
      scan(rest, language, [span("comment", ";" + body), ..done])
    }
    ["%", ..rest] if language == "erlang" || language == "erl" -> {
      let #(body, rest) = until_line(rest, [])
      scan(rest, language, [span("comment", "%" + body), ..done])
    }
    [quote, ..rest] if quote == "\"" || quote == "'" -> {
      let #(body, rest) = quoted(rest, quote, [])
      scan(rest, language, [span("string", quote + body), ..done])
    }
    [char, ..rest] -> match word_char(char) {
      True -> {
        let #(word, rest) = word(rest, [char])
        let kind = match list.contains(
          string.split(
            "module import class enum interface actor external native from is with be var let new self super match if fn loop in test assert as panic todo echo True False Nil skip pub type opaque const use case of when receive after fun end begin try catch def defp defmodule do else true false nil and or not div rem defun defmodule defmacro lambda SELECT FROM WHERE INSERT INTO VALUES RETURNING CREATE TABLE",
            " "
          ),
          word
        ) {
          True -> "keyword"
          False -> match string.contains("0123456789", char) {
            True -> "number"
            False -> match rest {
              ["(", ..] -> "function"
              _ if string.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", char) -> "type"
              _ -> "name"
            }
          }
        }
        scan(rest, language, [span(kind, word), ..done])
      }
      False -> scan(rest, language, [html.escape(char), ..done])
    }
  }
}

word_char(char: String) -> Bool {
  (
    string.contains("abcdefghijklmnopqrstuvwxyz", char)
  ) || (string.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", char)) || (
    string.contains("0123456789", char)
  ) || char == "_"
}

word(chars: List(String), done: List(String)) -> #(String, List(String)) {
  match chars {
    [char, ..rest] if word_char(char) -> word(rest, [char, ..done])
    _ -> #(list.reverse(done) |> string.join(""), chars)
  }
}

until_line(chars: List(String), done: List(String)) -> #(String, List(String)) {
  match chars {
    [] -> #(list.reverse(done) |> string.join(""), [])
    ["\n", ..] -> #(list.reverse(done) |> string.join(""), chars)
    [char, ..rest] -> until_line(rest, [char, ..done])
  }
}

quoted(chars: List(String), quote: String, done: List(String)) -> #(
  String,
  List(String)
) {
  match chars {
    [] -> #(list.reverse(done) |> string.join(""), [])
    ["\\", next, ..rest] -> quoted(rest, quote, [next, "\\", ..done])
    [char, ..rest] if char == quote -> #(
      list.reverse([char, ..done]) |> string.join(""),
      rest
    )
    [char, ..rest] -> quoted(rest, quote, [char, ..done])
  }
}

/// Diagnostic gutters carry the severity of the preceding headline. Leave
/// source excerpts and explanatory paragraphs in the normal terminal colour.
diagnostic_lines(
  rows: List(String),
  severity: String,
  done: List(String)
) -> List(String) {
  match rows {
    [] -> list.reverse(done)
    [line, ..rest] -> {
      let text = string.trim_start(line)
      let kind = diagnostic_kind(text)
      let active = match kind {
        "" -> severity
        _ -> kind
      }
      let shown = match kind {
        "" -> diagnostic_detail(line, text, active)
        _ -> match string.split_once(text, ":") {
          Some(#(label, message)) ->
          html.escape(indentation(line, text)) + terminal_span(kind, label) +
          terminal_span("bold", ":" + message)
          None -> html.escape(line)
        }
      }
      diagnostic_lines(rest, active, [shown, ..done])
    }
  }
}

diagnostic_kind(text: String) -> String {
  match True {
    _ if string.starts_with(text, "error: ") -> "fail"
    _ if string.starts_with(text, "warning: ") -> "msg"
    _ -> ""
  }
}

diagnostic_detail(line: String, text: String, severity: String) -> String {
  let indent = indentation(line, text)
  match True {
    _ if string.starts_with(text, "╭─ ") ->
    html.escape(indent) + terminal_span("violet", "╭─") + " " +
    terminal_span("msg", string.slice(text, 3, string.length(text)))
    _ if text == "╰─" -> html.escape(indent) + terminal_span("violet", text)
    _ if string.starts_with(text, "help:") || string.starts_with(text, "note:") ->
    html.escape(indent) + terminal_span("msg", string.slice(text, 0, 5)) +
    html.escape(string.slice(text, 5, string.length(text)))
    _ if string.starts_with(text, "Found ") && (
      string.ends_with(text, " error.") || string.ends_with(text, " errors.") ||
      string.ends_with(text, " warning.") || string.ends_with(
        text,
        " warnings."
      )
    ) -> terminal_span("bold", line)
    _ -> match string.split_once(line, "│") {
      Some(#(gutter, body)) -> {
        let marks = string.trim_start(body)
        let result = match string.trim(gutter) == "" && (
          string.starts_with(marks, "─") || string.starts_with(marks, "╰─") ||
          string.starts_with(marks, "┬")
        ) {
          True -> html.escape(indentation(body, marks)) + terminal_span(
            severity,
            marks
          )
          False -> html.escape(body)
        }
        terminal_span("violet", gutter + "│") + result
      }
      None -> terminal(line)
    }
  }
}

indentation(line: String, trimmed: String) -> String {
  string.slice(line, 0, string.length(line) - string.length(trimmed))
}

terminal_span(kind: String, text: String) -> String {
  "<span class=\"t-" + kind + "\">" + html.escape(text) + "</span>"
}

is_activity(label: String) -> Bool {
  list.contains(
    [
      "Downloading",
      "Downloaded",
      "Compiling",
      "Compiled",
      "Running",
      "Checking",
      "Checked",
      "Finished",
      "Formatted",
      "Exported",
      "Publishing",
      "Published",
      "Added",
      "Removed",
      "Updated",
      "Generated",
      "Cleaned"
    ],
    label
  )
}

terminal_line(line: String) -> Bool {
  let text = string.trim_start(line)
  let #(label, _) = first_word(text)
  is_activity(label) || echo_location(text) ||
  string.starts_with(text, "$ ") || string.starts_with(text, "✓ ") ||
  string.starts_with(text, "✗ ") || string.starts_with(text, "• ")
}

first_word(text: String) -> #(String, String) {
  match string.split_once(text, " ") {
    Some(#(word, rest)) -> #(word, " " + rest)
    None -> #(text, "")
  }
}

/// The runtime prints a location on a line of its own before the plain value.
echo_location(text: String) -> Bool {
  match string.split_once(text, ".pooka:") {
    Some(#(path, line)) -> path != "" && line != "" &&
    list.all(string.split(line, ""), fn(char) {
      string.contains("0123456789", char)
    })
    None -> False
  }
}

terminal(line: String) -> String {
  let text = string.trim_start(line)
  let indent = html.escape(indentation(line, text))
  let #(label, rest) = first_word(text)
  match True {
    _ if is_activity(label) -> {
      let detail = match #(label, string.split_once(rest, " in ")) {
        #("Finished", Some(#(prefix, elapsed))) ->
        html.escape(prefix + " in ") + terminal_span("dim", elapsed)
        _ -> html.escape(rest)
      }
      indent + terminal_span("label", label) + detail
    }
    _ if echo_location(text) -> indent + terminal_span("dim", text)
    _ if label == "$" -> indent + terminal_span("label", "$") + html.escape(
      rest
    )
    _ if label == "✓" -> indent + terminal_span("pass", label) + html.escape(
      rest
    )
    _ if label == "✗" -> indent + terminal_span("fail", label) + html.escape(
      rest
    )
    _ if label == "•" -> indent + terminal_span("label", label) + html.escape(
      rest
    )
    _ if string.starts_with(text, "+ ") || string.contains(text, " + ") ->
    terminal_span("diff-add", line)
    _ if string.starts_with(text, "- ") || string.contains(text, " - ") ->
    terminal_span("diff-remove", line)
    _ if label == "expected" ->
    indent + terminal_span("dim", label) + terminal_span("violet", rest)
    _ if label == "got" ->
    indent + terminal_span("dim", label) + terminal_span("fail", rest)
    _ if string.starts_with(text, "panic:") || string.starts_with(text, "todo:") ||
    string.starts_with(text, "assertion failed:") ->
    terminal_span("msg", line)
    _ -> html.escape(line)
  }
}

/// A plain fence becomes a tree only when every nonempty row looks like a
/// portable filename and at least one directory is present. Ordinary prose
/// and unknown language fences keep their literal spelling.
is_tree(source: String) -> Bool {
  let rows = list.filter(string.split(source, "\n"), fn(line) {
    string.trim(line) != ""
  })
  !list.is_empty(rows) && list.any(rows, fn(line) {
    string.contains(line, "/")
  }) && list.all(rows, fn(line) {
    let #(name, note) = tree_name(string.split(string.trim_start(line), ""), [])
    name != "" && (
      note == "" || string.starts_with(note, "  ") || string.starts_with(
        note,
        "\t"
      )
    ) && list.all(string.split(name, ""), fn(char) {
      word_char(char) || list.contains([".", "@", "-", "/"], char)
    })
  })
}

tree_name(chars: List(String), found: List(String)) -> #(String, String) {
  match chars {
    [] -> #(string.join(list.reverse(found), ""), "")
    [char, ..rest] if char == " " || char == "\t" -> #(
      string.join(list.reverse(found), ""),
      string.join(chars, "")
    )
    [char, ..rest] -> tree_name(rest, [char, ..found])
  }
}

tree_line(line: String) -> String {
  let trimmed = string.trim_start(line)
  let indent = string.slice(
    line,
    0,
    string.length(line) - string.length(trimmed)
  )
  let #(name, note) = tree_name(string.split(trimmed, ""), [])
  let parts = string.split(name, "/")
  let shown = match name {
    "..." -> "<span class=\"t-dim\">...</span>"
    _ if list.length(parts) > 1 -> {
      let prefix = string.join(list.take(parts, list.length(parts) - 1), "/") + "/"
      let leaf = string.join(list.drop(parts, list.length(parts) - 1), "")
      "<span class=\"t-dir\">" + html.escape(prefix) + "</span>" + html.escape(
        leaf
      )
    }
    _ -> html.escape(name)
  }
  html.escape(indent) + shown + match note {
    "" -> ""
    _ -> "<span class=\"t-dim\">" + html.escape(note) + "</span>"
  }
}
