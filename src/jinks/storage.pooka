//// Filesystem errors retain the path that caused them. Every caller gets
//// the same Result shape, so the command boundary can explain one failure.
module storage

import jinks/boundary
import pooka/file
import pooka/list
import pooka/path

read(name: String) -> Result(String, String) {
  match file.read(name) {
    Ok(text) -> Ok(text)
    Error(e) -> Error(e.path + ": " + e.message)
  }
}

write(name: String, text: String) -> Result(Nil, String) {
  let _ = match file.create_directories(path.dirname(name)) {
    Ok(_) -> Ok(Nil)
    Error(e) -> Error(e.path + ": " + e.message)
  }?
  match file.write(name, text) {
    Ok(_) -> Ok(Nil)
    Error(e) -> Error(e.path + ": " + e.message)
  }
}

/// Enumerate files only. Sorting is independent of filesystem iteration order.
files(root: String, prefix: String) -> Result(List(String), String) {
  boundary.files(root, prefix)
}

walk(root: String, prefix: String, names: List(String), found: List(String)) -> Result(
  List(String),
  String
) {
  match names {
    [] -> Ok(found)
    [name, ..rest] -> {
      let relative = match prefix {
        "" -> name
        _ -> prefix + "/" + name
      }
      let nested = match file.is_directory(path.join([root, relative])) {
        Ok(b) -> Ok(b)
        Error(e) -> Error(e.path + ": " + e.message)
      }?
      let entries = match nested {
        True -> files(root, relative)
        False -> Ok([relative])
      }?
      walk(root, prefix, rest, list.concat(found, entries))
    }
  }
}
