//// A filename should keep its meaning when the site crosses machines.
//// Windows device names remain reserved even with an extension; trailing
//// dots and spaces can otherwise make two written names mean one file.
module names

import pooka/list
import pooka/string

external _Unicode from erlang "unicode" {
  characters_to_nfc_binary(text: String) -> String
}

/// Equivalent Unicode spellings must not claim separate output files.
canonical(text: String) -> String {
  _Unicode.characters_to_nfc_binary(text)
}

/// ```pooka
/// assert names.portable("owl.html")
/// assert !names.portable("NUL.html")
/// ```
portable(segment: String) -> Bool {
  let stem = match string.split(string.lowercase(segment), ".") {
    [head, ..rest] -> head
    [] -> ""
  }
  !string.is_empty(segment) && !string.ends_with(segment, ".") && !string.ends_with(
    segment,
    " "
  ) && !list.contains(
    [
      "con",
      "prn",
      "aux",
      "nul",
      "com1",
      "com2",
      "com3",
      "com4",
      "com5",
      "com6",
      "com7",
      "com8",
      "com9",
      "lpt1",
      "lpt2",
      "lpt3",
      "lpt4",
      "lpt5",
      "lpt6",
      "lpt7",
      "lpt8",
      "lpt9"
    ],
    stem
  ) && !list.any(string.to_list(segment), fn(c) {
    c < 32 || c == 127 || list.contains(
      [34, 42, 47, 58, 60, 62, 63, 92, 124],
      c
    )
  })
}
