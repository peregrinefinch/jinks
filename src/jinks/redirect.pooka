//// Static hosts cannot promise an HTTP 301 just because a file asks nicely.
//// An alias is an HTML fallback: a canonical link, immediate refresh, and a
//// visible link for readers whose browser does not follow the refresh.
module redirect

import marksy/html
import jinks/route

render(canonical: String) -> String {
  render_url(route.url(canonical))
}

/// The build supplies a checked, deployment-prefixed URL. Escape it once for
/// every HTML attribute and the visible fallback link.
render_url(target: String) -> String {
  let target = html.escape(target)
  "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Page moved</title><link rel=\"canonical\" href=\"" + target + "\"><meta http-equiv=\"refresh\" content=\"0; url=" + target + "\"></head><body><p>This page has moved. <a href=\"" + target + "\">Continue to the page</a>.</p></body></html>\n"
}
